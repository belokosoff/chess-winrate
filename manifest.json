{
  "manifest_version": 3,
  "name": "Winrate Stats for Chess.com",
  "version": "1.0.0",
  "description": "Winrate, openings, endings, time usage and head-to-head stats for chess.com players. Statistics only, no move hints.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.chess.com/*"],
  "action": {
    "default_title": "Winrate Stats for Chess.com",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": [
        "src/core.js",
        "src/i18n.js",
        "src/settings.js",
        "src/api.js",
        "src/stats.js",
        "src/ui.js",
        "src/content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{8e8af65d-526a-4537-9fd5-db5bc0e44ef2}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
